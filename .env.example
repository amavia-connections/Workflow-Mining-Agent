# ==============================================================================
# Environment Configuration Template for Workflow Mining Agent
# AI Builder Cup 2026
#
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Operational Mode: 'DEMO' for local standalone, 'CLOUD' for GCP Vertex AI & BigQuery
APP_MODE=DEMO

# Google Cloud Platform Project Details
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
BIGQUERY_DATASET=workflow_mining

# Gemini on Vertex AI Settings
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Financial Rate Defaults for Deterministic Labor Savings
DEFAULT_HOURLY_LABOR_RATE=65.00
DEFAULT_AUTOMATABLE_PERCENTAGE=0.75

# Server Bind Settings
HOST=0.0.0.0
PORT=8000
