# Normalize line endings to LF for all text files (cross-platform consistency)
* text=auto eol=lf

# Python
*.py        text eol=lf

# Terraform
*.tf        text eol=lf
*.tfvars    text eol=lf

# Web
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf

# Config & CI
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf

# Markdown & docs
*.md        text eol=lf
*.txt       text eol=lf

# Shell
*.sh        text eol=lf

# Binary files — no line-ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
